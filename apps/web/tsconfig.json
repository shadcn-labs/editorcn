{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "collections/*": ["./.source/*"],
      "@editorcn/ui/*": ["../../packages/ui/src/*"],
      "@editorcn/editor": ["../../packages/editor/src"],
      "@editorcn/editor/*": ["../../packages/editor/src/*"],
      "@editorcn/block-editor": ["../../packages/block-editor/src"],
      "@editorcn/block-editor/*": ["../../packages/block-editor/src/*"],
      "@editorcn/floating-menu": ["../../packages/floating-menu/src"],
      "@editorcn/floating-menu/*": ["../../packages/floating-menu/src/*"],
      "@tiptap/core": [
        "../../node_modules/.pnpm/@tiptap+core@2.27.2_@tiptap+pm@2.27.2/node_modules/@tiptap/core"
      ],
      "@tiptap/pm": [
        "../../node_modules/.pnpm/@tiptap+pm@2.27.2/node_modules/@tiptap/pm"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["./node_modules"]
}
