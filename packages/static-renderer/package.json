{
  "name": "@editorcn/static-renderer",
  "version": "0.2.4",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node -e \"require('fs').copyFileSync('src/style.css','dist/style.css')\"",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.0",
    "xss": "^1.0.17"
  },
  "devDependencies": {
    "@tiptap/extension-highlight": "^3.30.5",
    "@tiptap/extension-image": "^3.30.5",
    "@tiptap/extension-list": "^3.30.5",
    "@tiptap/extension-subscript": "^3.30.5",
    "@tiptap/extension-superscript": "^3.30.5",
    "@tiptap/extension-table": "^3.30.5",
    "@tiptap/extension-text-align": "^3.30.5",
    "@tiptap/extension-text-style": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@types/react": "^19",
    "@types/react-dom": "^19.2.3",
    "tsup": "^8.4.0",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "@tiptap/core": ">=3.21.0 <4",
    "@tiptap/pm": ">=3.21.0 <4",
    "@tiptap/static-renderer": ">=3.21.0 <4",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  }
}
