{
  "name": "editorcn",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:registry": "node scripts/build-registry.mjs",
    "sync:styles": "node scripts/sync-styles.mjs",
    "check:editor-ui": "node scripts/check-editor-ui.mjs",
    "typecheck": "turbo typecheck",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "dev:web": "turbo -F web dev",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@editorcn/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@editorcn/config": "workspace:*",
    "@types/node": "^22.13.14",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "shadcn": "^4.21.0",
    "turbo": "^2.9.16",
    "typescript": "catalog:",
    "ultracite": "7.6.1"
  },
  "packageManager": "pnpm@10.12.4"
}
